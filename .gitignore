android/app/*.jks

# Если проект лежит не в корне, а в apps/mobile — те же правила:
apps/mobile/android/.gradle/
apps/mobile/android/.idea/
apps/mobile/android/local.properties
apps/mobile/android/**/build/
apps/mobile/android/app/release/
apps/mobile/android/app/*.keystore
apps/mobile/android/app/*.jks

# ===== React Native: iOS =====
ios/Pods/
ios/build/
ios/DerivedData/
**/*.xcuserstate
**/*.xcuserdatad
**/*.pbxuser

# В monorepo-пути:
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/ios/DerivedData/
apps/mobile/ios/**/*.xcuserstate
apps/mobile/ios/**/*.xcuserdatad
apps/mobile/ios/**/*.pbxuser

