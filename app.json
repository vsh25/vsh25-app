{
  "expo": {
    "name": "vsh25-app",
    "slug": "vsh25-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "net.vsh25.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "sentry-expo",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "f36a08e0-93e8-4802-aab4-c8a09431cbce"
      }
    },
    "owner": "vsh25"
  }
}
